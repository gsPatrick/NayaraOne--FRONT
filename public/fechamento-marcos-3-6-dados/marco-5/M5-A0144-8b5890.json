   "sql": "SELECT (SELECT legal_responsible_user_id FROM legal.contract_templates WHERE id = :t) AS resp_modelo, (SELECT array_agg(status || ':' || COALESCE(published_by::text, '-') ORDER BY version_number) FROM legal.template_versions WHERE template_id = :t) AS versoes_modelo, (SELECT legal_responsible_user_id FROM legal.clause_library WHERE code = :code) AS resp_clausula, (SELECT count(DISTINCT clause_library_id)::int FROM legal.clause_versions WHERE code = :code) AS bibliotecas",
