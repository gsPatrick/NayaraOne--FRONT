   "sql": "SELECT d.last_alerted_severity, d.escalated_at IS NOT NULL AS escalado, d.status, (SELECT count(*) FROM core.tasks t WHERE t.related_entity_type = 'legal.legal_deadlines' AND t.related_entity_id = d.id AND t.priority = 'CRITICAL') AS ocorrencias, (SELECT count(*) FROM integration.outbox_events o WHERE o.aggregate_id = d.id AND o.event_type = 'legal.deadline.overdue') AS eventos_overdue, (SELECT count(*) FROM integration.outbox_events o WHERE o.aggregate_id = d.id AND o.event_type = 'legal.deadline.created') AS eventos_created, (SELECT count(*) FROM core.notifications n WHERE n.user_id = :resp AND n.title = 'Prazo jurídico VENCIDO' AND n.body LIKE '%' || d.description || '%') AS avisos_responsavel, (SELECT count(*) FROM core.notifications n WHERE n.user_id = :esc AND n.body LIKE '%' || d.description || '%') AS avisos_escalonamento FROM legal.legal_deadlines d WHERE d.id = :id",
