 "requisito": "async createContractVersion(contractId, draft, ctx) {\n    const contract = await contracts.get(contractId);\n    assertEditableState(contract.status);\n    const rendered = await renderer.render(draft.templateVersionId, draft.data);\n    const hash = sha256(rendered.bytes);\n    return versions.create({\n        contractId,\n        versionNo: await versions.nextNumber(contractId),\n        templateVersionId: draft.templateVersionId,\n        contentHash: hash,\n        fileId: await files.store(rendered.bytes),\n        status: 'DRAFT',\n        createdBy: ctx.userId,\n    });\n}",
 "demandas": "M5-D003",
