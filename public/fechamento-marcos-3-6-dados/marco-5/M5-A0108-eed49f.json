   "descricao": "Prazos gravados: origem verificável (arquivo ou evento), due_at no fuso de São Paulo (\"2030-01-01\" = 23:59 de Brasília), criticidade, responsável e a TAREFA do responsável (Guia §12)",
   "sql": "SELECT d.description, d.source_file_id IS NOT NULL AS origem_arquivo, d.source_event_type, d.source_document, d.due_at::text AS due_at_utc, to_char(d.due_at AT TIME ZONE 'America/Sao_Paulo', 'YYYY-MM-DD HH24:MI') AS due_at_sao_paulo, d.criticality, d.responsible_user_id IS NOT NULL AS tem_responsavel_proprio, d.status, t.related_entity_type AS tarefa_tipo, t.status AS tarefa_status, t.priority AS tarefa_prioridade, t.assigned_to_user_id = COALESCE(d.responsible_user_id, c.responsible_user_id) AS tarefa_do_responsavel, t.due_at = d.due_at AS tarefa_mesmo_vencimento FROM legal.legal_deadlines d JOIN legal.legal_cases c ON c.id = d.legal_case_id LEFT JOIN core.tasks t ON t.id = d.task_id WHERE d.legal_case_id = :id ORDER BY d.created_at",
