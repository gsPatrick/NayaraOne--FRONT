   "sql": "SELECT l.evidence_package_id = :pkgNota AS do_dossie_nota, l.action, l.accessed_by_user_id IS NOT NULL AS tem_usuario, l.accessed_at::text AS accessed_at, (SELECT count(*) FROM audit.audit_log a WHERE a.entity_id = l.id AND a.action = 'legal.evidence_package.access') AS auditorias FROM legal.evidence_package_access_log l WHERE l.evidence_package_id IN (:pkg, :pkgNota) ORDER BY l.accessed_at",
