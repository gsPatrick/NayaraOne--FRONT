 "requisito": "async deliverKeys(contractId, input, ctx) {\n    await assertPermission(ctx, 'lease.keys.deliver');\n    await assertRequirementsSatisfied(contractId, 'KEY_DELIVERY', ctx);\n    const contract = await contracts.get(contractId);\n    assertIn(['SIGNED','ACTIVE'], contract.status);\n    return db.transaction(async tx => {\n        const delivery = await keyDeliveries.create(tx, input);\n        await outbox.append(tx, keysDeliveredEvent(contract, delivery, ctx));\n        return delivery;\n    });\n}",
