   "descricao": "Depois da tentativa de encerramento: obrigações, tarefas pendentes e reembolso continuam no banco",
   "sql": "SELECT (SELECT count(*)::int FROM legal.lease_obligations WHERE contract_id = :c AND deleted_at IS NULL) AS obrigacoes, (SELECT count(*)::int FROM finance.ownership_transfer_tasks t JOIN legal.lease_obligations u ON u.id = t.utility_obligation_id WHERE u.contract_id = :c AND t.status = 'PENDING') AS pendentes, (SELECT count(*)::int FROM finance.utility_reimbursements WHERE id = :r AND status = 'PENDING') AS reembolsos",
