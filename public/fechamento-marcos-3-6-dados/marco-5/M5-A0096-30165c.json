   "perfil": "A:gestor",
   "descricao": "Outbox: um lease.obligation.overdue por tarefa pendente (luz e gás), e as tarefas continuam PENDING",
   "sql": "SELECT e.aggregate_id, count(*)::int AS eventos, max(t.status) AS tarefa FROM integration.outbox_events e JOIN finance.ownership_transfer_tasks t ON t.id = e.aggregate_id WHERE e.event_type = 'lease.obligation.overdue' AND e.aggregate_id IN (:ids) GROUP BY e.aggregate_id",
