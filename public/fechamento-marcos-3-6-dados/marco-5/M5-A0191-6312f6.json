   "id": "MT-T21-SQL",
   "grupos": [],
   "f": [],
   "descricao": "Catálogo: legal.evidence_packages existe com o nome do livro, é tabela (relkind r), tem company_id e RLS ENABLE+FORCE",
   "sql": "SELECT 'legal.evidence_packages' AS tabela_do_livro, to_regclass('legal.evidence_packages') IS NOT NULL AS existe_com_o_nome_do_livro, c.relkind::text AS tipo, c.relrowsecurity AS rls_enable, c.relforcerowsecurity AS rls_force, EXISTS (SELECT 1 FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attname = 'company_id' AND NOT a.attisdropped) AS tem_company_id, NULL AS tabela_que_guarda_hoje, f.relkind::text AS tipo_da_que_guarda, f.relrowsecurity AS rls_enable_da_que_guarda, f.relforcerowsecurity AS rls_force_da_que_guarda FROM (SELECT 1) x LEFT JOIN pg_class c ON c.oid = to_regclass('legal.evidence_packages') LEFT JOIN pg_class f ON f.oid = to_regclass(NULL)",
   "resultado": [
    {
     "tabela_do_livro": "legal.evidence_packages",
     "existe_com_o_nome_do_livro": true,
     "tipo": "r",
     "rls_enable": true,
     "rls_force": true,
     "tem_company_id": true,
     "tabela_que_guarda_hoje": null,
     "tipo_da_que_guarda": null,
     "rls_enable_da_que_guarda": null,
     "rls_force_da_que_guarda": null
    }
   ],
