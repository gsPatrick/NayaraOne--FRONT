   "sql": "SELECT p.id, p.package_hash, jsonb_array_length(p.manifest_json) AS itens, p.manifest_json->0->>'hash' AS hash_item, f.checksum_sha256 AS hash_arquivo, p.manifest_json->0->>'originalName' AS nome, p.manifest_json->0->>'createdAt' AS data, p.manifest_json->0->>'source' AS origem, (SELECT array_agg(o.event_type ORDER BY o.event_type) FROM integration.outbox_events o WHERE o.aggregate_id = p.id) AS eventos FROM legal.evidence_packages p JOIN people.files f ON f.id = :file WHERE p.id IN (:a, :b) ORDER BY p.created_at",
