   "perfil": "A:checker",
   "descricao": "Aprovação da VERSÃO: versão APPROVED com o aprovador, contrato com approved_version_id e auditorias (versão e contrato) com o aprovador",
   "sql": "SELECT v.status, v.approved_by, c.approved_version_id = v.id AS homologada, (SELECT count(*)::int FROM audit.audit_log a WHERE a.user_id = v.approved_by AND ((a.entity_id = v.id AND a.action = 'legal.contract_version.approve') OR (a.entity_id = c.id AND a.action = 'legal.contract.status_change' AND a.after_json->>'status' = 'APPROVED'))) AS auditorias FROM legal.contract_versions v JOIN legal.contracts c ON c.id = v.contract_id WHERE v.id = :v",
   "resultado": [
