 "requisito": "async createDeadline(input, ctx) {\n    if (!input.sourceFileId && !input.sourceEventId) {\n        throw new ValidationError('DEADLINE_SOURCE_REQUIRED');\n    }\n    const d = await deadlines.create(input);\n    await tasks.create({\n        responsibleUserId: d.responsibleUserId,\n        dueAt: d.dueAt,\n        severity: d.severity,\n        sourceType: 'LEGAL_DEADLINE',\n        sourceId: d.id,\n    });\n    return d;\n}",
 "demandas": "M5-D035;M5-D036",
