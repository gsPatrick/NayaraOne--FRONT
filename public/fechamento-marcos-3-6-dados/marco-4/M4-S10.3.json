   "descricao": "Recebível de R$ 0,30: pai, baixas filhas e saldo = valor − Σ baixas SETTLED",
   "sql": "select p.id, p.amount, p.status, p.settled_at, (select count(*) from finance.financial_entries f where f.parent_entry_id = p.id and f.status = 'SETTLED')::int as baixas, (select coalesce(sum(f.amount),0) from finance.financial_entries f where f.parent_entry_id = p.id and f.status = 'SETTLED') as baixado, p.amount - (select coalesce(sum(f.amount),0) from finance.financial_entries f where f.parent_entry_id = p.id and f.status = 'SETTLED') as saldo from finance.financial_entries p where p.id = :id",
