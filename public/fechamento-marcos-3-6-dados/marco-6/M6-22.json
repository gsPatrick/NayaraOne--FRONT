      "descricao": "Almoxarifado: saldo = soma dos movimentos; saídas da obra e devoluções (RETURN) com custo histórico",
      "sql": "SELECT b.quantity_on_hand AS saldo, (SELECT coalesce(sum(CASE WHEN movement_type IN ('IN','RETURN') THEN quantity WHEN movement_type IN ('OUT','LOSS') THEN -quantity ELSE 0 END),0) FROM inventory.inventory_movements WHERE inventory_item_id = $1) AS soma_movimentos, (SELECT coalesce(sum(quantity),0) FROM inventory.inventory_movements WHERE project_id = $3 AND movement_type = 'OUT') AS saida_para_obra, (SELECT coalesce(sum(quantity),0) FROM inventory.inventory_movements WHERE project_id = $3 AND movement_type = 'RETURN') AS devolvido FROM inventory.stock_balances b WHERE b.inventory_item_id = $1 AND b.location_id = $2",
      "resultado": [
        {
          "saldo": "263.000000",
          "soma_movimentos": "263.0000",
          "saida_para_obra": "48.0000",
          "devolvido": "11.0000"
        }
